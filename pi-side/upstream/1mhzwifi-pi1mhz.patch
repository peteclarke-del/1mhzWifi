index 49f2689..91bdd72 100644
--- a/firmware/Pi1MHz/Pi1MHz.cfg
+++ b/firmware/Pi1MHz/Pi1MHz.cfg
@@ -29,7 +29,7 @@
 # Helpers_addr=0x88
 # BeebSID_addr=0x20        # BeebSID is DISABLED by default; setting this
 #                          # enables it and disables the Music 5000
-# Rampage_addr=0xFD
+Rampage_addr=0xFD
 # Rambyte_addr=0x00
 # Harddisc_addr=0x40
 # M5000_addr=0x00
@@ -44,9 +44,9 @@
 # Watchdog_addr=0x00       # (use the "watchdog" key below, not this)
 
 # ---- BeebSCSI hard disc ---------------------------------------------------
-# SCSIJUKE=0               # initial SCSI LUN jukebox directory
-# SCSIID=0                 # SCSI ID
-# VFSJUKE=0                # VFS jukebox directory
+SCSIJUKE=0               # initial SCSI LUN jukebox directory
+SCSIID=0                 # SCSI ID
+VFSJUKE=0                # VFS jukebox directory
 
 # ---- audio ----------------------------------------------------------------
 # BeebAudio_Off=1          # mute the Beeb's own audio passthrough (the
@@ -111,3 +111,15 @@
 # teletext_server3=a.b.c.d:port   # channel 3
 # teletext_server4=a.b.c.d:port   # channel 4 (port optional, default 19761)
 # teletext_debug=1                # log teletext events
+
+# ElkWiFi host transport: AP5 forwards the FCA0-FCAF block
+Services_addr=0xA6
+ElkWiFi_addr=0x00
+
+# Required by the ElkWiFi ROM transport
+net_enable=1
+
+# Initial ElkWiFi menu source; an explicit *MENUSRC setting overrides it
+# elkwifi_menu_url=http://acornelectron.nl/uefarchive/MENU
+# elkwifi_utc_offset_minutes=0  # DATE/TIME offset east of UTC; e.g. 60 for BST
+# wifi_security=auto      # auto|open|wep|wpa|wpa2
