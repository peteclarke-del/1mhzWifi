 #define NET_CMD_UDP_SENDTO   55u
 #define NET_CMD_UDP_RECVFROM 56u
 #define NET_CMD_IRQ          57u   /* [1] 0=disarm (default) / 1=arm nIRQ     */
+#define NET_CMD_COPY_PUBLIC  58u   /* internal: scratch -> public 64K JIM    */
