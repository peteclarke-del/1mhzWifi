+#include "ram_emulator.h"
 #include "services.h"
 #include "net_service.h"
 #include "net_tnfs.h"
@@ -359,4 +359,25 @@ int main(void)
       CHECK(jrd24(CP(0)+1) == 0, "second recv returns 0 (ring drained)");
    }
 
+   printf("== private scratch-to-public JIM copy ==\n");
+   world_reset();
+   {
+      uint8_t expected[240];
+      for (unsigned i = 0; i < sizeof expected; i++)
+         expected[i] = (uint8_t)(i * 37u + 11u);
+      memcpy(&Pi1MHz->JIM_ram[DISC_RAM_BASE + 0xfff100u],
+             expected, sizeof expected);
+      jwr8(CP(0)+1, (uint8_t)sizeof expected);
+      jwr8(CP(0)+2, 0xf0u);
+      jwr8(CP(0)+3, 0x01u);
+      CHECK(issue(NET_CMD_COPY_PUBLIC, 0) == NET_OK,
+            "scratch-to-public copy -> OK");
+      CHECK(memcmp(&Pi1MHz->JIM_ram[0x01f0u], expected,
+                   sizeof expected) == 0,
+            "copy is exact across a public JIM page boundary");
+      jwr8(CP(0)+1, 0u);
+      CHECK(issue(NET_CMD_COPY_PUBLIC, 0) == NET_ERR_PARAM,
+            "zero-length public copy is rejected");
+   }
+
    printf("== back-pressure (ERR_MEM park, redeliver) ==\n");
