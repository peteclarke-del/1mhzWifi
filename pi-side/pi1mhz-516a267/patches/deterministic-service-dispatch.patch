@@ -81,6 +81,21 @@ static uint8_t  aun_last_cmd;
 static void test_aun_handler(uint32_t cp, uint32_t addr, uint8_t data)
 { (void)addr; (void)data; aun_calls++; aun_last_cmd = Pi1MHz->JIM_ram[cp]; }
 
+static uint32_t fixed_calls[3];
+static uint8_t fixed_last_cmd[3];
+static void fixed_handler(unsigned int index, uint32_t cp, uint32_t addr)
+{
+   fixed_calls[index]++;
+   fixed_last_cmd[index] = Pi1MHz->JIM_ram[cp];
+   Pi1MHz_MemoryWrite(addr, (uint8_t)(0x40u + index));
+}
+void net_service_command(uint32_t cp, uint32_t addr, uint8_t data)
+{ (void)data; fixed_handler(0u, cp, addr); }
+void elkwifi_service_command(uint32_t cp, uint32_t addr, uint8_t data)
+{ (void)data; fixed_handler(1u, cp, addr); }
+void secure_service_command(uint32_t cp, uint32_t addr, uint8_t data)
+{ (void)data; fixed_handler(2u, cp, addr); }
+
 /* ---- helpers driving the real dispatch ---- */
