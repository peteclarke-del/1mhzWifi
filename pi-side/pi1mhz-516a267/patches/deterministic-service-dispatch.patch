diff --git a/src/Pi1MHz.c b/src/Pi1MHz.c
--- a/src/Pi1MHz.c
+++ b/src/Pi1MHz.c
@@ -429,11 +429,24 @@ int notmain (void) {
 
    for( uint8_t i=0; i <NUM_EMULATORS; i++)
       {
+         /* These fixed command ranges are dispatched by Services itself.
+            Disabling only their poller would leave requests permanently BUSY,
+            so configuration must disable the Services port as a whole. */
+         bool fixed_services_child = emulator[i].init == net_service_init ||
+            emulator[i].init == elkwifi_service_init ||
+            emulator[i].init == secure_service_init;
          // "<name>_addr=0xNN" overrides the FRED base address; a negative
          // value (e.g. "<name>_addr=-1") disables the emulator.
          int ov = config_emulator_override(emulator[i].name, &emulator[i].address);
          if (ov < 0)
             {
+               if (fixed_services_child)
+                  {
+                     LOG_WARN("Ignoring %s_addr=-1: fixed Services command range\r\n",
+                              emulator[i].name);
+                     emulator[i].enable = 1;
+                     continue;
+                  }
                LOG_DEBUG("Disabling %s\r\n", emulator[i].name);
                emulator[i].enable = 0;
             }
