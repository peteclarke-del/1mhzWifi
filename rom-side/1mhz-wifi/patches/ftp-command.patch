+                    equb >ftp_cmd, <ftp_cmd
+ENDIF
                     equs "WIFI"
                     equb >wifi_cmd, <wifi_cmd
                     equs "VERSION"
@@ -476,6 +480,9 @@ ELSE
 \ must match the one around the entry it describes.
