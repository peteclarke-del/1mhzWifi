+ENDIF
                     equs "WiFi control ON|OFF|HR|SR",&0D
                     equs "Print firmware version",&0D
                     equs "Set LAP options",&0D
@@ -566,6 +573,9 @@ include "join.asm"
 include "mode.asm"
