 OSFINDV	=	&021C		\OSFIND vector (Open sequential)
 OSBGETV	=	&0216		\OSBGET vector (sequential read)
 
-\WiCFS owns this unused part of cassette filing-system workspace while
-\selected. It is below application PAGE and outside Tube and ADFS workspace.
-FILVRTN        = &03E8    \saved predecessor FILEV address
-filev_prev_rom = &03EA    \predecessor FILEV ROM, or &FF for direct
-BGETRTN        = &03EB    \saved predecessor BGETV address
-bget_prev_rom  = &03ED    \predecessor BGETV ROM, or &FF for direct
-findv_prev_rom = &03EE    \predecessor FINDV ROM, or &FF for direct
-FSCVRTN        = &03EF    \saved predecessor FSCV address
-fscv_prev_rom  = &03F1    \predecessor FSCV ROM, or &FF for direct
-bytev_rtn      = &03F2    \saved BYTEV address beneath the *TAPE trap
-wicfs_magic    = &03F4    \two-byte installed-state guard
+\The MOS keyboard input buffer occupies &03E0-&03FF. Never place WiCFS state
+\there: MENU and *UEF depend on the queued *REWIND and CHAIN commands remaining
+\intact. Lifecycle state is mirrored transiently in ROM heap and persisted
+\through the AP5-forwarded Pi1MHz byte port at reserved services-buffer address
+\&FFEF00. The AP5 does not forward &FCFD/&FCFE, so a page-mode state bank would
+\alias and corrupt the UEF in the standard 64K JIM window.
+wicfs_state_ram = heap+&E8
+slotid          = wicfs_state_ram+0
+findv_rtn       = wicfs_state_ram+1
+FILVRTN         = wicfs_state_ram+3
+filev_prev_rom  = wicfs_state_ram+5
+BGETRTN         = wicfs_state_ram+6
+bget_prev_rom   = wicfs_state_ram+8
+findv_prev_rom  = wicfs_state_ram+9
+FSCVRTN         = wicfs_state_ram+10
+fscv_prev_rom   = wicfs_state_ram+12
+bytev_rtn       = wicfs_state_ram+13
+wicfs_magic     = wicfs_state_ram+15
+wicfs_state_size = 17
 
 serbuf	=	&06E0		\serial input buffer
 notape	=	&0398		\location of external *TAPE trap
 hchunk	=	&03CB		\Chunk header type(2) + length(4)
 
 bufsize	=	28		\data burst (buffer) size
-sbuft	=	&03E4		\persistent start-of-UEF flag
-sbufl	=	&03E2		\persistent bytes-left count (lo)
-sbufh	=	&03E3		\persistent bytes-left count (hi)
+sbuft	=	&F5		\official WiCFS start-of-UEF flag
+sbufl	=	&F8		\official WiCFS bytes-left count (lo)
+sbufh	=	&F9		\official WiCFS bytes-left count (hi)
 temp	=	&C4		\zp temporary
-slotid	=	&03E5		\persistent WiCFS ROM slot
 fscv_x         = &C9    \must be zero page for (fscv_x),Y
 fscv_y         = &CA
 chain_rom      = heap+&E1 \transient state for the RAM ROM-switch trampoline
@@ -74,14 +81,12 @@
