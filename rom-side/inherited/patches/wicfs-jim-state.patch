@@ -169,12 +173,95 @@
 \vectors. No code is placed in &0400-&07FF because that is Tube host workspace.
 
 \external *UPCFS interface code
 .bUPCFS	
 \ Keep the command-service stack handling outside the callable installer.
 \ *UEF uses the same installer before it queues REWIND and CHAIN.
 	JSR	wicfs_install
 	JMP	call_claimed
+
+\Persist only vector ownership and predecessor addresses outside host RAM.
+\&FFEF00-&FFEF15 is immediately below the services command pages at &FFF000.
+\Both helpers preserve A/X/Y; transactional load reports validity in carry.
+\Each byte is addressed explicitly:
+\Pi1MHz publishes FCA6-FCA9 changes from FIQ context, so relying on FCA9's
+\asynchronous auto-increment can duplicate, omit or reorder persisted bytes.
+\The private CPU delay contains no FRED reads and therefore cannot itself
+\change or acknowledge the shared services cursor.
+.wicfs_bus_delay
+	PHP
+	PHA
+	LDA	#64
+.wicfs_bus_delay_loop
+	SEC
+	SBC	#1
+	BNE	wicfs_bus_delay_loop
+	PLA
+	PLP
+	RTS
+.wicfs_state_address_x
+	TXA
+	STA	&FCA6
+	JSR	wicfs_bus_delay
+	LDA	#&EF
+	STA	&FCA7
+	JSR	wicfs_bus_delay
+	LDA	#&FF
+	STA	&FCA8
+	JSR	wicfs_bus_delay
+	RTS
+.wicfs_state_load
+	PHP
+	SEI
+	PHA
+	TXA
+	PHA
+	TYA
+	PHA
+	LDX	#0
+.wicfs_state_load_loop
+	JSR	wicfs_state_address_x
+	LDA	&FCA9
+	JSR	wicfs_bus_delay
+	STA	wicfs_state_ram,X
+	INX
+	CPX	#wicfs_state_size
+	BNE	wicfs_state_load_loop
+	PLA
+	TAY
+	PLA
+	TAX
+	PLA
+	PLP
+	RTS
+
+.wicfs_state_save
+	PHP
+	SEI
+	PHA
+	TXA
+	PHA
+	TYA
+	PHA
+	LDX	#0
+.wicfs_state_save_loop
+	JSR	wicfs_state_address_x
+	LDA	wicfs_state_ram,X
+	STA	&FCA9
+	JSR	wicfs_bus_delay
+	INX
+	CPX	#wicfs_state_size
+	BNE	wicfs_state_save_loop
+	PLA
+	TAY
+	PLA
+	TAX
+	PLA
+	PLP
+	RTS
 .wicfs_install
+\Reload the installation record on every external entry. Application code and
+\other ROM commands may freely reuse &0900-&09FF between vector calls.
+	JSR	wicfs_state_load
     if __debug = 1
     php:jsr debug
     equs "in bupcfs",&0D,&EA
