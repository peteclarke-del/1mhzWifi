diff --git a/rom/wicfs.asm b/rom/wicfs.asm
--- a/rom/wicfs.asm
+++ b/rom/wicfs.asm
@@ -914,1 +914,9 @@
+	LDA	&3C8		\zero-byte CFS files have no data byte to fetch
+	ORA	&3C9
+	BNE	ldb_data
+	JSR	adjlen		\remove the already-consumed header and CRC bytes
