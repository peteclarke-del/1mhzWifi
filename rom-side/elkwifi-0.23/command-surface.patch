diff --git a/rom/serial.asm b/rom/serial.asm
--- a/rom/serial.asm
+++ b/rom/serial.asm
@@ -223,7 +223,7 @@
 \ Saves the current 64K bank number of the paged RAM
 .save_bank_nr
  pha                \ save A register
- lda uart_mcr       \ load current value
+ lda &FCFE          \ Pi1MHz JIM window selector
  sta bank_save      \ save in memory
  pla                \ restore A register
  rts                \ end subroutines
@@ -233,6 +233,6 @@
 .restore_bank_nr
  pha                \ save A register
  lda bank_save      \ load saved value
- sta uart_mcr       \ write to uart
+ sta &FCFE          \ restore Pi1MHz JIM window
  pla                \ restore A register
  rts                \ end subroutines
@@ -241,17 +241,7 @@
 \ Sets the bank number to the value of the lsb of A
 .set_bank_nr
  pha                \ save A register
- pha                \ save A register
- lda uart_mcr       \ load mcr
- and #&F7           \ clear bit 3
- sta uart_mcr       \ write back to mcr
- pla                \ restore A
  and #&01           \ mask bit 0
- clc                \ clear carry for shifting
- asl a              \ shift four times right
- asl a
- asl a
- ora uart_mcr       \ 'or' the A with the current value of the mcr
- sta uart_mcr       \ set the new value
+ sta &FCFE          \ select Pi1MHz JIM window 0 or 1
  pla                \ restore A
  rts                \ end of routine
@@ -270,4 +260,5 @@
 \ Even more faster, write A to MCR
 .set_bank_a
- sta uart_mcr       \ write value to MCR
+ and #&01           \ only two Pi1MHz ElkWiFi JIM windows are defined
+ sta &FCFE
  rts
