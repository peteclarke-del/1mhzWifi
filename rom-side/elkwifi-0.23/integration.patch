diff --git a/rom/routines.asm b/rom/routines.asm
index 2cd2fd2..10cb31c 100644
--- a/rom/routines.asm
+++ b/rom/routines.asm
@@ -261,12 +261,25 @@ if __ELECTRON__
 .print_logo
  jsr test_wifi_ena          \ test wifi enabled status
  bne logo2                  \ jump if wifi is disabled
- ldx #7                     \ load index for copy
+ \ The stock ROM copied the glyph to fixed address &60A0, permanently tying
+ \ it to row zero while the MOS banner followed the current boot cursor.
+ \ Define a user character and print it through the VDU so the icon stays on
+ \ the same row as "Acorn Electron WiFi" with any ROM ordering or scrolling.
+ lda #' '
+ jsr oswrch
+ lda #23
+ jsr oswrch
+ lda #255
+ jsr oswrch
+ ldx #0
 .logo1
  lda wifi_symbol,x          \ load data
- sta &60A0,x                \ write to screen
- dex                        \ decrement index
- bpl logo1                  \ jump if bytes follow
+ jsr oswrch
+ inx
+ cpx #8
+ bne logo1
+ lda #255
+ jsr oswrch
 .logo2
  rts                        \ end of routine
 else
diff --git a/rom/serial.asm b/rom/serial.asm
index 16c6a60..fb18b16 100644
--- a/rom/serial.asm
+++ b/rom/serial.asm
@@ -258,18 +258,16 @@
  rts                \ end of routine
 
 \ Alternative bank number set routine, shorter and faster
 .set_bank_0         \ set it to 0
- lda uart_mcr       \ load current value
- and #&F7           \ clear bit 3 (MFB)
- sta uart_mcr       \ write it back
- rts                \ end of routine
+ lda #0             \ select Pi1MHz JIM window &FFF000 directly on the host
+ sta &FCFE
+ rts
 
 \ Alternative bank number set routine, shorter and faster
 .set_bank_1         \ set it to 1
- lda uart_mcr       \ load current value
- ora #&08           \ clear bit 3 (MFB)
- sta uart_mcr       \ write it back
- rts                \ end of routine
+ lda #1             \ select second 64K Pi1MHz JIM window
+ sta &FCFE
+ rts
 
 \ Even more faster, write A to MCR
 .set_bank_a
@@ -278,9 +278,9 @@
 \ Test if wifi is disabled
 \ This will return with Z=1 if wifi is disabled and Z=0 if wifi is enabled
 .test_wifi_ena
- lda uart_mcr       \ load status
- and #&01           \ test lowest bit (DTR)
- rts                \ return
+ lda #0             \ Pi1MHz WiFi is managed by the kernel, not a local UART
+ and #&01           \ report enabled without touching unforwarded &FC34
+ rts
 
 \ Setup the serial port A
 \ Parameters in ZP+6 and up: baudrate, parity, databits, stopbits
