diff --git a/rom/wicfs.asm b/rom/wicfs.asm
--- a/rom/wicfs.asm
+++ b/rom/wicfs.asm
@@ -69,0 +70,2 @@
+tape_len_lo = heap+&DF \current UEF length, refreshed by every successful WGET -U
+tape_len_hi = heap+&E0
@@ -1601,0 +1605,4 @@
+    LDA sbufl
+    STA tape_len_lo
+    LDA sbufh
+    STA tape_len_hi
@@ -1657,1 +1663,14 @@
-    jsr cfsinit     \ initialize the tape (i.e. set pointers to beginning of paged RAM)
+    \ WGET -U has already replaced the current UEF, published its length and
+    \ reset pr_r/pr_y. Keep REWIND entirely in host RAM: the menu executes it
+    \ while transitioning from TITLES to a game and no JIM transaction or
+    \ additional subroutine stack frame is required here.
+    lda tape_len_lo
+    sta sbufl
+    lda tape_len_hi
+    sta sbufh
+    lda #0
+    sta pr_y
+    sta pr_r
+    sta sfopen
+    sta sfptr
+    sta sbuft
