diff --git a/rom/wicfs.asm b/rom/wicfs.asm
--- a/rom/wicfs.asm
+++ b/rom/wicfs.asm
@@ -839,2 +839,43 @@
 .stl_skip_ok
 	JMP	stl_a2		\and loop for next chunk
+
+\ Some protected tape loaders restore the Electron's default vectors before
+\ issuing *TAPE. That is valid for a physical cassette, but disconnects a
+\ virtual cassette filing system between stages. The published Zalaga image
+\ contains this exact loader at &0400. Replace only its verified vector-copy
+\ loop with a jump over the reset; its following *TAPE then reaches WiCFS's
+\ normal OSBYTE &8C trap and the Scrunch/ElkZalaga3 stages remain on WiCFS.
+.protect_loader_vectors
+	BIT	loadrun		\only execution loads can contain a loader
+	BPL	plv_done
+	LDX	#0
+.plv_check
+	LDA	&0400,X
+	CMP	plv_signature,X
+	BNE	plv_done
+	INX
+	CPX	#(plv_signature_end-plv_signature)
+	BNE	plv_check
+	LDX	#0
+.plv_tape_check
+	LDA	&04A8,X
+	CMP	plv_tape,X
+	BNE	plv_done
+	INX
+	CPX	#(plv_tape_end-plv_tape)
+	BNE	plv_tape_check
+	LDA	#&4C		\JMP &0418, immediately after the copy loop
+	STA	&040A
+	LDA	#&18
+	STA	&040B
+	LDA	#&04
+	STA	&040C
+.plv_done
+	RTS
+.plv_signature
+	equb &AE,&B7,&FF,&AC,&B8,&FF,&86,&70,&84,&71,&AC,&B6
+	equb &FF,&88,&B1,&70,&99,&00,&02,&98,&D0,&F7,&A9,&EA
+.plv_signature_end
+.plv_tape
+	equs "TAPE",&0D
+.plv_tape_end
