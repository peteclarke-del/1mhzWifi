--- a/rom/wicfs.asm
+++ b/rom/wicfs.asm
@@ -1898,6 +1898,8 @@
     lda sbufl       \check if end-of-tape is reached
     ora sbufh       \when empty this will result to &00
     beq nodata      \jump if &00, end-of-tape is reached
+    php             \the AP5 JIM selectors are shared with other services
+    sei             \keep bank, page and data read one atomic transaction
     jsr set_bank_1  \select paged ram bank
     ldy pr_y        \load pointer to paged ram
     lda pr_r
@@ -1912,6 +1914,11 @@
     lda pr_r        \load page-register shadow
     sta pagereg     \select the next physical page
     jsr set_bank_0  \select first paged ram bank
+    lda #0          \leave the complete public JIM address at 00:00:00
+    sta pagereg
+    pla             \recover data before the older saved flags below it
+    plp
+    pha             \preserve data while updating the software byte count
     dec sbufl       \decrement tape counter
     lda sbufl
     cmp #&FF
@@ -1934,13 +1941,18 @@
     lda sbufl       \check if end-of-tape is reached
     ora sbufh       \when empty this will result to &00
     beq nodata      \jump if &00, end-of-tape is reached
+    php             \protect the shared selector for the non-forwarding peek too
+    sei
     jsr set_bank_1  \select paged ram bank
     ldy pr_y        \load pointer to paged ram
     lda pr_r
     sta pagereg
     lda pageram,y   \load data
     pha             \save data
     jsr set_bank_0  \select first paged ram bank
+    lda #0
+    sta pagereg
     pla
+    plp             \the data byte was stacked above the saved flags
 	CLC 			\and return flagging byte ready (C=0)
 	RTS
@@ -1969,5 +1981,7 @@
 	LDA	#1		    \set CFS active flags true
 	STA	CFSact2
+    php             \read the Pi length trailer without a shared-JIM race
+    sei
     JSR set_bank_1  \ retain the stock bank call; AP5 exposes one 64K window
     LDA #&FF        \get tape length 
     STA pagereg     \ (this is stored in the last two bytes of the paged RAM)
@@ -1978,6 +1992,7 @@
     JSR set_bank_0
     LDA #0
     STA pagereg
+    plp
 	LDA	#0
     STA pr_y        \reset pointer to paged ram
     sta pr_r
