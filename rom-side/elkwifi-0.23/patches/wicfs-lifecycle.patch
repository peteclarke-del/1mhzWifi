 OSFINDV	=	&021C		\OSFIND vector (Open sequential)
 OSBGETV	=	&0216		\OSBGET vector (sequential read)
 
-FILVRTN	=	&03A3		\Tape FILEV vector contents
-FSCVRTN	=	&03A5		\Tape FSCV vector contents
+\WiCFS owns this unused part of cassette filing-system workspace while
+\selected. It is below application PAGE and outside Tube and ADFS workspace.
+FILVRTN        = &03E8    \saved predecessor FILEV address
+filev_prev_rom = &03EA    \predecessor FILEV ROM, or &FF for direct
+BGETRTN        = &03EB    \saved predecessor BGETV address
+bget_prev_rom  = &03ED    \predecessor BGETV ROM, or &FF for direct
+findv_prev_rom = &03EE    \predecessor FINDV ROM, or &FF for direct
+FSCVRTN        = &03EF    \saved predecessor FSCV address
+fscv_prev_rom  = &03F1    \predecessor FSCV ROM, or &FF for direct
+bytev_rtn      = &03F2    \saved BYTEV address beneath the *TAPE trap
+wicfs_magic    = &03F4    \two-byte installed-state guard
 
 serbuf	=	&06E0		\serial input buffer
 notape	=	&0398		\location of external *TAPE trap
@@ -41,9 +49,6 @@
 sbufh	=	&03E3		\persistent bytes-left count (hi)
 temp	=	&C4		\zp temporary
