--- a/rom/wicfs.asm
+++ b/rom/wicfs.asm
@@ -2265,8 +2265,25 @@
 \seven-byte dispatch frame, and transfers directly to the loaded program.
 .actioned
 	LDY	loadrun
-	BPL	ret_fscv
+	BMI	actioned_run	\capturing the return address pushes ret_fscv out
+	JMP	ret_fscv	\of branch range, so reach it through a jump
+.actioned_run
 	PLP			\loaded code receives the native extended-vector stack
+	\ Capture where this call returns to, taken from the dispatch frame
+	\ while the frame is still the only thing on the stack. The exit below
+	\ jumps through this copy rather than unwinding a frame it did not
+	\ build, so the transfer no longer depends on which dispatcher entered
+	\ the vector. chain_target is free here: it belongs to the
+	\ predecessor-forward paths, which are the alternative to having
+	\ claimed the call at all.
+	TSX
+	LDA	&0101,X
+	CLC
+	ADC	#1		\a pushed JSR address is one before the real target
+	STA	chain_target
+	LDA	&0102,X
+	ADC	#0
+	STA	chain_target+1
 	\ Reproduce the native cassette execution context without assuming a ROM
 	\ slot. If the displaced cassette vector was a direct MOS vector, retain
 	\ the real caller context captured from the extended-vector frame.
@@ -2336,7 +2353,9 @@
 	TAY
 .run_call
 	JSR	&FFFF		\patched to the loaded execution address
-	RTS			\return through the intact MOS extended-vector frame
+	PLA			\drop the frame return the jump below replaces, so
+	PLA			\the caller is reached at its own stack depth
+	JMP	(chain_target)	\frame-agnostic exit to the captured return
 .run_code_end
 .ret_fscv
 	PLP
