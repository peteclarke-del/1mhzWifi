diff --git a/rom/routines.asm b/rom/routines.asm
index 2cd2fd2..10cb31c 100644
--- a/rom/routines.asm
+++ b/rom/routines.asm
@@ -261,12 +261,25 @@ if __ELECTRON__
 .print_logo
  jsr test_wifi_ena          \ test wifi enabled status
  bne logo2                  \ jump if wifi is disabled
- ldx #7                     \ load index for copy
+ \ The stock ROM copied the glyph to fixed address &60A0, permanently tying
+ \ it to row zero while the MOS banner followed the current boot cursor.
+ \ Define a user character and print it through the VDU so the icon stays on
+ \ the same row as "Acorn Electron WiFi" with any ROM ordering or scrolling.
+ lda #' '
+ jsr oswrch
+ lda #23
+ jsr oswrch
+ lda #255
+ jsr oswrch
+ ldx #0
 .logo1
  lda wifi_symbol,x          \ load data
- sta &60A0,x                \ write to screen
- dex                        \ decrement index
- bpl logo1                  \ jump if bytes follow
+ jsr oswrch
+ inx
+ cpx #8
+ bne logo1
+ lda #255
+ jsr oswrch
 .logo2
  rts                        \ end of routine
 else
