--- a/rom/wicfs.asm
+++ b/rom/wicfs.asm
@@ -1395,7 +1395,9 @@
 	SEI
 	LDA	#3
 .guard_common
-	STA	romsel+(guard_kind-s_guard)
+	PHA		\the kind rides the stack. A mirrored body cannot hold
+			\it, and page three has no free byte: &0398 is the
+			\*TAPE trap and &0396 is filev_x.
 	TXA
 	PHA
 	TYA
@@ -1406,7 +1408,9 @@
 	JSR	OSBYTE
 	STX	evptr
 	STY	evptr+1
-	LDX	romsel+(guard_kind-s_guard)
+	TSX		\Y and X were pushed above the kind
+	LDA	&0103,X
+	TAX
 	LDY	romsel+(guard_offsets-s_guard),X
 	LDA	romsel+(guard_handler_lo-s_guard),X
 	STA	(evptr),Y
@@ -1416,29 +1420,31 @@
 	INY
 	LDA	romsel+(guard_slot-s_guard)
 	STA	(evptr),Y
-	LDA	romsel+(guard_dispatch-s_guard),X
-	STA	romsel+(guard_call-s_guard)+1
+	LDA	romsel+(guard_offsets-s_guard),X	\the dispatcher low byte is
+				\the same 3*index as the table offset
+	STA	evptr
+	LDA	#&FF
+	STA	evptr+1
 	PLA
 	TAY
 	PLA
 	TAX
+	PLA		\discard the kind
 	PLA
 	PLP
-.guard_call
-	JSR	&FF1B
+	JSR	romsel+(guard_indirect-s_guard)	\the guard runs at romsel,
+				\not at its address in the ROM
 	RTS
+.guard_indirect
+	JMP	(evptr)
 .guard_offsets
 	equb	27,33,42,45
 .guard_handler_lo
 	equb	<upfilev,<upbgetv,<upfindv,<upfscv
 .guard_handler_hi
 	equb	>upfilev,>upbgetv,>upfindv,>upfscv
-.guard_dispatch
-	equb	&1B,&21,&2A,&2D
 .guard_slot
 	equb	0
-.guard_kind
-	equb	0
 .e_guard
 ASSERT romsel+(e_guard-s_guard) <= &0800
 
