+\ Replace the live cassette predecessors with the filing-system snapshot only
+\ at the ownership-checked retirement boundary. Until this point unclaimed
+\ operations must behave exactly as they do through the native cassette ROM.
+.wicfs_load_pre_tape
+	LDX	#0
+	JSR	wicfs_pending_address_x
+	LDA	&FCA9
+	JSR	wicfs_bus_delay
+	CMP	#&A5
+	BNE	wicfs_load_pre_tape_done
+	LDX	#1
+.wicfs_load_pre_tape_loop
+	JSR	wicfs_pending_address_x
+	LDA	&FCA9
+	JSR	wicfs_bus_delay
+	LDY	wicfs_snapshot_ram_offsets-1,X
+	STA	wicfs_state_ram,Y
+	INX
+	CPX	#13
+	BNE	wicfs_load_pre_tape_loop
+	LDX	#14
+	JSR	wicfs_pending_address_x
+	LDA	&FCA9
+	JSR	wicfs_bus_delay
+	STA	bytev_rtn
+	INX
+	JSR	wicfs_pending_address_x
+	LDA	&FCA9
+	JSR	wicfs_bus_delay
+	STA	bytev_rtn+1
+.wicfs_load_pre_tape_done
+	RTS
 
 \ An invalid persisted record cannot supply BYTEV's predecessor. Accept only
 \ an intact RAM trap and recover the JMP target embedded when it was installed.
