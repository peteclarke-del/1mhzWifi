diff --git a/rom/wicfs.asm b/rom/wicfs.asm
--- a/rom/wicfs.asm
+++ b/rom/wicfs.asm
@@ -60,2 +60,7 @@ optmask	=	&B7		\mask for *OPT setting (two values)
-pr_y    =   &C7     \data pointor to paged ram (Y-reg)
-pr_r    =   &C8     \data pointer to paged ram (page register)
+\ Keep the WiCFS cursor out of transient MOS and language zero page. BASIC,
+\ Tube filing calls and service polling may run between vector invocations.
+pr_y    =   heap+&D8 \data pointer to paged ram (offset)
+pr_r    =   heap+&D9 \data pointer to paged ram (page-register shadow)
+filev_x =   heap+&DA \OSFILE/OSFIND require X and Y to be preserved
+filev_y =   heap+&DB
+bget_y  =   heap+&DC \OSBGET returns data in A and preserves X and Y
@@ -113,3 +118 @@ __debug =   0       \print debug information
-	LDA	&F4		    \record which slot UPURS occupies
-	STA	slotid
-	LDA	#vdu_off	\turn off screen output to hide
+	LDA	#vdu_on		\keep queue and filing errors visible
@@ -162 +165,6 @@ __debug =   0       \print debug information
-	BNE	b_a1	    	\no, loop for next
+	BNE	b_a1	    	\no, loop for next
+
+\Patch the copied switcher's immediate ROM number after queued BASIC commands
+\have completed. This survives MOS and Tube zero-page use without claiming
+\ADFS workspace or changing the size and address of the later MENU code.
+	LDA	&F4 : STA romsel+(aupurs_slot+1-s_filev)
@@ -235,2 +243,4 @@ __debug =   0       \print debug information
-.upfilev
-    if __debug = 1
+.upfilev
+    STX filev_x
+    STY filev_y
+    if __debug = 1
@@ -259,2 +269,2 @@ __debug =   0       \print debug information
-.upf_a1	JSR	starload		\goto action file load
-	JMP	romsel+(actioned-s_filev)	\and return claiming command
+.upf_a1	JSR	starload		\goto action file load
+	JMP	romsel+(filev_actioned-s_filev) \claim and preserve OSFILE X/Y
@@ -276 +286 @@ __debug =   0       \print debug information
-.upf_a5	JMP	romsel+(actioned-s_filev)	\and return claiming command
+.upf_a5	JMP	romsel+(filev_actioned-s_filev) \claim and preserve OSFILE X/Y
@@ -332,2 +342,3 @@ __debug =   0       \print debug information
-.upbgetv
-    if __debug = 1
+.upbgetv
+    STY bget_y
+    if __debug = 1
@@ -361 +372 @@ __debug =   0       \print debug information
-	JMP	romsel+(actioned-s_filev)	\and return claiming command
+	JMP	romsel+(bget_actioned-s_filev) \claim and preserve OSBGET X/Y
@@ -390 +401,2 @@ __debug =   0       \print debug information
-	LDA	slotid		\then select UPURS rom
+.aupurs_slot
+	LDA	#0		\ROM slot patched into the copied switcher by *QUPCFS
@@ -404 +416,14 @@ __debug =   0       \print debug information
-	JMP	(FILVRTN)		\and follow original FILEV vector
+	LDX	filev_x
+	LDY	filev_y
+	JMP	(FILVRTN)		\and follow original FILEV vector
+
+.filev_actioned
+	JSR	romsel+(bupurs-s_filev)
+	LDX	filev_x
+	LDY	filev_y
+	RTS
+
+.bget_actioned
+	JSR	romsel+(bupurs-s_filev)
+	LDY	bget_y
+	RTS
@@ -438 +463 @@ __debug =   0       \print debug information
-.s_end	NOP			\dummy address marker for code download
+.s_end				\end marker for the copied switcher
@@ -1390 +1415 @@ __debug =   0       \print debug information
-    inc pagereg     \increment page register
+    inc pr_r        \advance the software shadow; FCFF is write-only through AP5/Pi1MHz
@@ -1393,2 +1418,2 @@ __debug =   0       \print debug information
-    lda pagereg     \load page register
-    sta pr_r        \save page register
+    lda pr_r        \load page-register shadow
+    sta pagereg     \select the next physical page
@@ -1452 +1476 @@ __debug =   0       \print debug information
-    JSR wget_context_switch_in
+    JSR set_bank_1  \ select JIM window before its page register
@@ -1459 +1484,3 @@ __debug =   0       \print debug information
-    JSR wget_context_switch_out
+    JSR set_bank_0
+    LDA #0
+    STA pagereg
