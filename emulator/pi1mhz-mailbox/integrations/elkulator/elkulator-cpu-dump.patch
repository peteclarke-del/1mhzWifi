+        if (!state) return;
+        fprintf(state,
+                "PC=%04X A=%02X X=%02X Y=%02X S=%02X P=%d%d%d%d%d%d ROM=%X EXT=%X CYC=%d\n",
+                pc,a,x,y,s,p.c,p.z,p.i,p.d,p.v,p.n,rombank,extrom,cycles);
+        fclose(state);
+}
 
